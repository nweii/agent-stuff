#!/bin/bash
# Regenerates skill catalogs, archives, and plugin metadata when their sources change.
# Enable via: git config core.hooksPath .githooks

set -e

STAGED=$(git diff --cached --name-only | grep -E '^(skills/|plugins/|scripts/|\.githooks/|\.claude-plugin/marketplace.json|\.agents/plugins/marketplace.json)' || true)
[ -z "$STAGED" ] && exit 0

echo "Agent sources changed — regenerating catalogs, zips, and plugin metadata..." >&2
python3 scripts/generate-plugins.py
for SOURCE in plugins/*/plugin-source.json; do
    [ -f "$SOURCE" ] || continue
    PLUGIN=${SOURCE#plugins/}
    PLUGIN=${PLUGIN%/plugin-source.json}
    python3 scripts/release-plugin.py "$PLUGIN" --check
done
git add -- .claude-plugin/marketplace.json .agents/plugins/marketplace.json
for MANIFEST in plugins/*/plugin.json plugins/*/.claude-plugin/plugin.json plugins/*/.codex-plugin/plugin.json; do
    [ -f "$MANIFEST" ] && git add -- "$MANIFEST"
done
python3 scripts/update-catalog.py
python3 scripts/build-zips.py

if ! git diff --quiet README.md 2>/dev/null; then
    git add README.md
    echo "Staged README.md with catalog update" >&2
fi

# Stage the rebuilt zip mirror (additions, content changes, and deletions of stale zips).
if ! git diff --quiet zips/ 2>/dev/null || [ -n "$(git ls-files --others --exclude-standard zips/)" ]; then
    git add -A zips/
    echo "Staged zips/ mirror" >&2
fi

exit 0
